<UserControl x:Class="AduosSyncServices.ServicesManager.Controls.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard">
            <DoubleAnimation Storyboard.TargetName="Rotator"
                              Storyboard.TargetProperty="Angle"
                              From="0" To="360"
                              Duration="0:0:0.9"
                              RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    <!-- The ring/arc are drawn in a fixed 20x20 design space and the Viewbox scales that uniformly to
         whatever size the consumer gives this control (14px in a list row, 36px in a busy overlay, etc.) -
         without this, the shapes stayed hardcoded at 20x20 regardless of the control's actual size, so
         they either got clipped (when used smaller than 20px) or sat small/off-center (when used larger). -->
    <Viewbox Stretch="Uniform">
        <Grid Width="20" Height="20" Loaded="Grid_Loaded">
            <Ellipse Width="20" Height="20" StrokeThickness="3" Stroke="#E5E7EB" />
            <Path Data="M 10,1 A 9,9 0 0 1 19,10" Stroke="#3B82F6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="Rotator" Angle="0" />
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
