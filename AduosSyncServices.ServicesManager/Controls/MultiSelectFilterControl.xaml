<UserControl x:Class="AduosSyncServices.ServicesManager.Controls.MultiSelectFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="11" Foreground="#6B7280" Margin="0,0,0,2" />

        <ToggleButton x:Name="ToggleBtn"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="8,5"
                      Cursor="Hand"
                      Click="ToggleBtn_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Background="White" BorderBrush="#B0B6C0" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                            <Path Grid.Column="1" Data="M0,0 L8,0 L4,5 Z" Fill="#6B7280" Margin="8,0,2,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#5A7DA7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <TextBlock x:Name="ButtonTextBlock" Text="Wszystkie" TextTrimming="CharacterEllipsis" />
        </ToggleButton>

        <Popup x:Name="OptionsPopup"
               PlacementTarget="{Binding ElementName=ToggleBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OptionsPopup_Closed">
            <Border Background="White" BorderBrush="#B0B6C0" BorderThickness="1" CornerRadius="4"
                    MinWidth="{Binding ActualWidth, ElementName=ToggleBtn}" Padding="6" Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,0,2,6">
                        <TextBlock Text="Zaznacz wszystkie" Foreground="#5A7DA7" Cursor="Hand" FontSize="11" MouseLeftButtonUp="SelectAll_Click" Margin="0,0,10,0" />
                        <TextBlock Text="Wyczyść" Foreground="#5A7DA7" Cursor="Hand" FontSize="11" MouseLeftButtonUp="ClearAll_Click" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcOptions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" VerticalAlignment="Center" Padding="4,3" Margin="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
