<Window x:Class="AduosSyncServices.ServicesManager.AddManualOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AduosSyncServices.ServicesManager.Controls"
        xmlns:helpers="clr-namespace:AduosSyncServices.ServicesManager.Helpers"
        Title="Dodaj zamówienie" Height="820" Width="1000" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Window.Resources>
        <!-- Shared styles (buttons, toggles, DataGrid pieces, BoolToVis) live in App.xaml; below are
             styles specific to this dialog. -->
        <Style x:Key="DangerSmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#EF4444" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style x:Key="SearchColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Wyszukaj produkt" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="Widoczne są tylko produkty podpięte na Allegro z aktywną ofertą. Wpisz min. 3 znaki, wybierz produkt z listy, aby dodać go do koszyka." Foreground="#6B7280" FontSize="12" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,20" HorizontalAlignment="Left">
                    <TextBox x:Name="TxtSearch" Width="420" Padding="8,6" BorderBrush="#D1D5DB"
                             TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown" />
                    <controls:LoadingSpinner x:Name="SearchSpinner" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />

                    <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=TxtSearch}" Placement="Bottom"
                           Width="660" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Background="White" Padding="4" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.15" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="85" />
                                        <!-- Reserves the same width as the results ScrollViewer's vertical scrollbar
                                             (forced always-visible below) so columns after "Produkt" line up with the
                                             header instead of drifting left whenever the scrollbar is present. -->
                                        <ColumnDefinition Width="17" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" Width="36" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="Kod" Style="{StaticResource SearchColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="Produkt" Style="{StaticResource SearchColumnHeaderStyle}" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="Stan" Style="{StaticResource SearchColumnHeaderStyle}" ToolTip="Stan magazynowy" />
                                    <TextBlock Grid.Column="4" Text="Opak." Style="{StaticResource SearchColumnHeaderStyle}" ToolTip="Wielokrotność opakowania" />
                                    <TextBlock Grid.Column="5" Text="Zakup" Style="{StaticResource SearchColumnHeaderStyle}" ToolTip="Cena zakupu" />
                                    <TextBlock Grid.Column="6" Text="Sprzedaż" Style="{StaticResource SearchColumnHeaderStyle}" ToolTip="Cena sprzedaży" />
                                </Grid>
                                <TextBlock x:Name="NoResultsText" Text="Brak wyników." Foreground="#6B7280" Padding="10" Visibility="Collapsed" />
                                <ScrollViewer x:Name="SearchResultsScrollViewer" MaxHeight="340" VerticalScrollBarVisibility="Visible" ScrollChanged="SearchResultsScrollViewer_ScrollChanged">
                                    <StackPanel>
                                        <ItemsControl x:Name="IcSearchResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="8" Cursor="Hand"
                                                            MouseLeftButtonUp="SearchResultRow_Click" Tag="{Binding}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="85" />
                                                                <ColumnDefinition Width="85" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding ImageUrl}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Code}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding InStock, StringFormat={}{0:0.##}}" VerticalAlignment="Center" Foreground="#374151" ToolTip="Stan magazynowy" />
                                                            <TextBlock Grid.Column="4" Text="{Binding PackQty, StringFormat={}{0:0.##}}" VerticalAlignment="Center" Foreground="#374151" ToolTip="Wielokrotność opakowania" />
                                                            <TextBlock Grid.Column="5" Text="{Binding PurchasePriceGross, StringFormat={}{0:N2} zł}" VerticalAlignment="Center" Foreground="#374151" ToolTip="Cena zakupu" />
                                                            <TextBlock Grid.Column="6" Text="{Binding SalePrice, StringFormat={}{0:N2} zł}" VerticalAlignment="Center" Foreground="#15803D" FontWeight="SemiBold" ToolTip="Cena sprzedaży" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <controls:LoadingSpinner x:Name="LoadMoreSpinner" Width="18" Height="18" Margin="0,8" HorizontalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Text="Koszyk" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,16" Background="White">
                    <DataGrid x:Name="DgCart" AutoGenerateColumns="False" IsReadOnly="False" MaxHeight="220" RowHeight="36"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False" CanUserResizeColumns="False">
                        <DataGrid.Resources>
                            <Style x:Key="CartCellBorderStyle" TargetType="Border">
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </Style>
                            <Style x:Key="CartCellTextStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ZeroPaddingDataGridCellStyle}" />
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogGridHeaderStyle}" />
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Kod" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBlock Text="{Binding Code}" Style="{StaticResource CartCellTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Produkt" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CartCellTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Jm" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource CartCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cena" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2} zł}" Style="{StaticResource CartCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ilość" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="4" VerticalAlignment="Center"
                                                     ToolTip="{Binding PackQtyHint}" LostFocus="TxtCartQuantity_LostFocus" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Wartość" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} zł}" Style="{StaticResource CartCellTextStyle}" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CartCellBorderStyle}">
                                            <Button Style="{StaticResource DangerSmallButtonStyle}" Content="Usuń" Click="BtnRemoveFromCart_Click" Tag="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Margin="0,0,0,10" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Koszt dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtDeliveryCost" Style="{StaticResource FieldTextBoxStyle}" Width="150" HorizontalAlignment="Left"
                                 TextChanged="TxtDeliveryCost_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wartość (produkty + dostawa)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtOrderTotal" Style="{StaticResource FieldTextBoxStyle}" Width="150" HorizontalAlignment="Left"
                                 IsReadOnly="True" Background="#F3F4F6" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Odbiorca" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="RbHeadquarters" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adres siedziby" />
                    <RadioButton x:Name="RbCustomer" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adres klienta" />
                </StackPanel>

                <StackPanel x:Name="AddressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Imię *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtFirstName" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Nazwisko *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtLastName" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Nazwa firmy (opcjonalnie)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtCompanyName" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Ulica i numer *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtStreet" Style="{StaticResource FieldTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Miasto *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtCity" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Kod pocztowy *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtPostalCode" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Kraj *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtCountry" Style="{StaticResource FieldTextBoxStyle}" Text="PL" />
                            <TextBlock Text="Telefon *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtPhone" Style="{StaticResource FieldTextBoxStyle}" />
                            <TextBlock Text="Email (opcjonalnie)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtEmail" Style="{StaticResource FieldTextBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Metoda dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="CbCourier" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Display" SelectionChanged="CbCourier_SelectionChanged" Margin="0,0,0,16" />

                <StackPanel x:Name="PaymentPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="Metoda płatności" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbWireTransfer" Style="{StaticResource TargetToggleStyle}" GroupName="Payment" Checked="PaymentType_Checked" Content="Przelew" />
                        <RadioButton x:Name="RbCod" Style="{StaticResource TargetToggleStyle}" GroupName="Payment" Checked="PaymentType_Checked" Content="Za pobraniem" />
                    </StackPanel>

                    <StackPanel x:Name="CodAmountPanel" Visibility="Collapsed">
                        <TextBlock Text="Kwota pobrania" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtCodAmount" Style="{StaticResource FieldTextBoxStyle}" Width="150" HorizontalAlignment="Left"
                                 TextChanged="TxtCodAmount_TextChanged" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="SummaryText" Foreground="#374151" Margin="0,0,0,16" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Content="Anuluj" Click="BtnCancel_Click" />
                    <Button x:Name="BtnSubmit" Style="{StaticResource PrimaryActionButtonStyle}" Content="Utwórz i złóż zamówienie" Click="BtnSubmit_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay: same styling/animation as OrderPlacementDialog's, per requested consistency. -->
        <Border x:Name="BusyOverlay" Background="#EEFFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                <controls:LoadingSpinner Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="BusyStatusText" FontSize="14" HorizontalAlignment="Center" Foreground="#374151" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" Margin="0,0,0,12" />

                <Border x:Name="StockCheckPanel" Visibility="Collapsed" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Background="White">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcStockCheck">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <controls:LoadingSpinner Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding ProductCode}" Width="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
