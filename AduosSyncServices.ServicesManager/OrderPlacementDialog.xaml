<Window x:Class="AduosSyncServices.ServicesManager.OrderPlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AduosSyncServices.ServicesManager.Controls"
        xmlns:helpers="clr-namespace:AduosSyncServices.ServicesManager.Helpers"
        Title="Złóż zamówienie u dostawcy" Height="720" Width="820" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Loaded="Window_Loaded">
    <!-- Shared styles (buttons, toggles, DataGrid pieces, BoolToVis) live in App.xaml. -->

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Cel dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="RbHeadquarters" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adres siedziby" />
                    <RadioButton x:Name="RbCustomers" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adresy klientów" />
                </StackPanel>

                <TextBlock Text="Metoda dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="CbCourier" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Display" SelectionChanged="CbCourier_SelectionChanged" Margin="0,0,0,16" />

                <StackPanel x:Name="CodPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="Kwota pobrania dla każdego zamówienia" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="IcCodAmounts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ClientName}" Width="Auto" MinWidth="140" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Pozycje zamówień" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,16" Background="White">
                    <!-- Row virtualization is OFF on purpose: auto-sized columns (Kod) only measure
                         realised rows, so a long code in a virtualized row would stay clipped forever.
                         CanContentScroll=False additionally gives smooth per-pixel scrolling. -->
                    <DataGrid x:Name="DgLineItems" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" RowHeight="48"
                              EnableRowVirtualization="False" ScrollViewer.CanContentScroll="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False" CanUserResizeColumns="False">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ZeroPaddingDataGridCellStyle}" />
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogGridHeaderStyle}" />
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Zdjęcie" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource PathToImage}}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Klient" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <TextBox Text="{Binding ClientName, Mode=OneWay}" Style="{StaticResource DialogCellTextStyle}" ToolTip="{Binding ClientName}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kod" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <TextBox Text="{Binding Code, Mode=OneWay}" Style="{StaticResource DialogCellTextStyle}" ToolTip="{Binding Code}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Produkt" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <!-- Nazwa is the only column allowed to truncate (ellipsis + full name in tooltip);
                                                 TextBox cannot render ellipsis, hence a TextBlock here. -->
                                            <TextBlock Text="{Binding OfferName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding OfferName}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ilość" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <TextBox Text="{Binding Quantity, Mode=OneWay}" Style="{StaticResource DialogCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Jm" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <TextBox Text="{Binding Unit, Mode=OneWay}" Style="{StaticResource DialogCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 130: wide enough for "Niestandardowy" at the dialog's 14px font incl. cell padding. -->
                            <DataGridTemplateColumn Header="Typ dostawy" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DialogCellBorderStyle}">
                                            <TextBox Text="{Binding DeliveryTypeDisplay, Mode=OneWay}" Style="{StaticResource DialogCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="SummaryText" Foreground="#374151" Margin="0,0,0,16" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Content="Anuluj" Click="BtnCancel_Click" />
                    <Button x:Name="BtnSubmit" Style="{StaticResource PrimaryActionButtonStyle}" Content="Złóż zamówienie na adres siedziby" Click="BtnSubmit_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay" Background="#EEFFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                <controls:LoadingSpinner Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="BusyStatusText" FontSize="14" HorizontalAlignment="Center" Foreground="#374151" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" Margin="0,0,0,12" />

                <Border x:Name="StockCheckPanel" Visibility="Collapsed" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Background="White">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcStockCheck">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <controls:LoadingSpinner Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding ProductCode}" Width="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
