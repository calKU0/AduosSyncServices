<Window x:Class="AduosSyncServices.ServicesManager.OrderPlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AduosSyncServices.ServicesManager.Controls"
        xmlns:helpers="clr-namespace:AduosSyncServices.ServicesManager.Helpers"
        Title="Złóż zamówienie u dostawcy" Height="720" Width="820" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Loaded="Window_Loaded">
    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisLocal" />
        <Style x:Key="TargetToggleStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#3B82F6" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Cel dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="RbHeadquarters" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adres siedziby" />
                    <RadioButton x:Name="RbCustomers" Style="{StaticResource TargetToggleStyle}" GroupName="Target" Checked="Target_Checked" Content="Adresy klientów" />
                </StackPanel>

                <TextBlock Text="Metoda dostawy" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="CbCourier" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Display" SelectionChanged="CbCourier_SelectionChanged" Margin="0,0,0,16" />

                <StackPanel x:Name="CodPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="Kwota pobrania dla każdego zamówienia" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="IcCodAmounts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding AllegroId}" Width="Auto" MinWidth="140" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Pozycje zamówień" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,16" Background="White">
                    <DataGrid x:Name="DgLineItems" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" RowHeight="36"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              BorderThickness="0" RowHeaderWidth="0" CanUserAddRows="False" CanUserResizeColumns="False">
                        <!-- Cells use a Border inside each column's DataTemplate for padding rather than
                             DataGrid.CellStyle.Padding - the latter does not reliably render in this DataGrid theme. -->
                        <DataGrid.Resources>
                            <Style x:Key="LineItemCellBorderStyle" TargetType="Border">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </Style>
                            <Style x:Key="LineItemCellTextStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F4F6" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nr Allegro" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineItemCellBorderStyle}">
                                            <TextBlock Text="{Binding AllegroId}" Style="{StaticResource LineItemCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kod" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineItemCellBorderStyle}">
                                            <TextBlock Text="{Binding Code}" Style="{StaticResource LineItemCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Produkt" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineItemCellBorderStyle}">
                                            <TextBlock Text="{Binding OfferName}" Style="{StaticResource LineItemCellTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ilość" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LineItemCellBorderStyle}">
                                            <TextBlock Text="{Binding Quantity}" Style="{StaticResource LineItemCellTextStyle}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="SummaryText" Foreground="#374151" Margin="0,0,0,16" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Content="Anuluj" Click="BtnCancel_Click" />
                    <Button x:Name="BtnSubmit" Style="{StaticResource PrimaryActionButtonStyle}" Content="Złóż zamówienie na adres siedziby" Click="BtnSubmit_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay" Background="#EEFFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                <controls:LoadingSpinner Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="BusyStatusText" FontSize="14" HorizontalAlignment="Center" Foreground="#374151" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" Margin="0,0,0,12" />

                <Border x:Name="StockCheckPanel" Visibility="Collapsed" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Background="White">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcStockCheck">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <controls:LoadingSpinner Width="14" Height="14" Margin="0,0,8,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisLocal}}" />
                                        <TextBlock Text="{Binding ProductCode}" Width="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
